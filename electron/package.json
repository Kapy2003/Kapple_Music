{
  "name": "kapple-music",
  "version": "1.0.0",
  "description": "Kapple Music, an Apple Music desktop client for Linux",
  "license": "MIT",
  "main": "main.mjs",
  "type": "module",
  "engines": {
    "electron": "^43.0.0"
  },
  "scripts": {
    "start": "bash ../scripts/build-renderer.sh && electron .",
    "dist": "npm run build:drm && npm run build:go && npm run build:engine && npm run build:vlc && electron-builder --linux AppImage",
    "postdist": "rm -f dist/builder-debug.yml dist/builder-effective-config.yaml",
    "clean": "bash ../scripts/clean.sh",
    "build:drm": "make -C ../drm libdrm_client.so android-stubs",
    "build:engine": "bash ../scripts/build-renderer.sh",
    "build:go": "bash ../scripts/build-engine.sh dist/resources -ldflags=\"-w -s\" -trimpath",
    "build:vlc": "bash ../scripts/bundle-vlc.sh",
    "lint": "eslint ."
  },
  "desktopName": "kapple-music.desktop",
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.36.0",
    "globals": "16.4.0"
  },
  "build": {
    "appId": "io.github.Kapy2003.KappleMusic",
    "productName": "Kapple Music",
    "copyright": "Copyright (c) Kapple Music contributors",
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!**/*.map",
      "!native/**/*.cpp",
      "!native/**/*.h",
      "!native/**/*.cmd",
      "!native/**/*.dll",
      "!test-*.html",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../assets/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../scripts/fetch-fairplay-libs.sh",
        "to": "fetch-fairplay-libs.sh"
      },
      {
        "from": "../drm/fairplay-libs.lock",
        "to": "fairplay-libs.lock"
      },
      {
        "from": "../drm/stubs/out",
        "to": "android-stubs"
      },
      {
        "from": "../drm/hybris-linker",
        "to": "hybris-linker"
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "AudioVideo",
      "description": "Kapple Music, an Apple Music desktop client for Linux and Windows",
      "executableName": "kapple-music",
      "artifactName": "Kapple-Music-${version}-x86_64.AppImage",
      "syncDesktopName": true,
      "mimeTypes": [
        "x-scheme-handler/kapple-music",
        "x-scheme-handler/kapple",
        "x-scheme-handler/music",
        "x-scheme-handler/musics",
        "x-scheme-handler/itms",
        "x-scheme-handler/itmss",
        "x-scheme-handler/itunes",
        "x-scheme-handler/itals",
        "x-scheme-handler/italss",
        "x-scheme-handler/itvls",
        "x-scheme-handler/itvlss",
        "x-scheme-handler/itsradio",
        "x-scheme-handler/itunesradio",
        "x-scheme-handler/daap",
        "x-scheme-handler/itpc"
      ],
      "extraResources": [
        {
          "from": "dist/resources/engine",
          "to": "engine"
        },
        {
          "from": "dist/resources/libdrm_client.so",
          "to": "libdrm_client.so"
        },
        {
          "from": "dist/resources/vlc",
          "to": "vlc"
        },
        {
          "from": "../third_party/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "protocols": [
      {
        "name": "Kapple Music",
        "schemes": [
          "kapple-music",
          "kapple"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "mpris-service": "^2.1.2",
    "x11": "^2.3.0"
  }
}
